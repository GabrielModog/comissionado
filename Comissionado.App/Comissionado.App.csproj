        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Comissionado.Core\Comissionado.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="..\vendas.json" Link="vendas.json">
